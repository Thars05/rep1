import java.util.*;
class Sushi{
  public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();
        int[] shari = new int[n];
        int[] neta = new int[m];
        for (int i = 0; i < n; i++) {
            shari[i] = sc.nextInt();
        }
        for (int j = 0; j < m; j++) {
            neta[j] = sc.nextInt();
        }
        Arrays.sort(shari);
        Arrays.sort(neta);
        int pair=0;
        int j=0;
        for(int i=0;i<m;i++){
          while(j<n && neta[i]>2*shari[j] ){
            j++;
          }
          if(j<n){
            pair++;
            j++;
          }else{
            break;
          }
            
            }
System.out.println("total sushi made: " + pair);
}
}
