class Solution {
    public boolean checkGoodInteger(int n) {

        int sum=0,dsum=0,r=0;
        while(n>0){
            r=n%10;
            sum+=r;
            dsum+=(r)*(r);
            n=n/10;
        }
        if((dsum-sum)>=50){
            return true;
        }else{
            return false;
        }
    }
}
