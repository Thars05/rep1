class MyStack {
    int[] arr;
    int top;
    public MyStack() {
        top=-1;
        arr=new int[1000];
    }
    
    public void push(int x) {
        if(top==arr.length-1){
            System.out.println("Stack full");


        }
        arr[++top]=x;// Pre-increment: changes -1 to 0 before placing element
    }
    
    
    public int pop() {
        if(top==-1){
            System.out.println("stack empty");
            return -1;

        }
        return arr[top--];// Post-decrement: returns value first, then decreases top
    }
    
    public int top() {
        return arr[top];
    }
    
    public boolean empty() {
        return top==-1;
    }
}

